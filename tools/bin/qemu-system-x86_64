#!/bin/bash
if [ -x /usr/bin/qemu-system-x86_64 ]; then
    exec /usr/bin/qemu-system-x86_64 "$@"
elif which flatpak >/dev/null 2>&1 && flatpak list | grep -q "org.virt_manager.virt-manager"; then
    exec flatpak run --command=qemu-system-x86_64 org.virt_manager.virt-manager "$@"
else
    echo "ERREUR: qemu-system-x86_64 introuvable (veuillez installer le paquet système : sudo apt install qemu-system-x86)" >&2
    exit 127
fi
