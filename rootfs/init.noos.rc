# Noos Android x86_64 Core Services & Init Configuration

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

on init
    # Binder IPC configuration
    mkdir /dev/binderfs
    mount binder binder /dev/binderfs
    chmod 0755 /dev/binderfs
    chmod 0666 /dev/binderfs/binder
    chmod 0666 /dev/binderfs/hwbinder
    chmod 0666 /dev/binderfs/vndbinder
    symlink /dev/binderfs/binder /dev/binder
    symlink /dev/binderfs/hwbinder /dev/hwbinder
    symlink /dev/binderfs/vndbinder /dev/vndbinder

on post-fs-data
    # Initialisation de la compatibilité Native Bridge
    start enable_nativebridge

service enable_nativebridge /system/bin/sh /system/bin/enable_nativebridge.sh
    class main
    user root
    group root
    oneshot
    disabled
