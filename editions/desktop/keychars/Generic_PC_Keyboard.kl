# Standard PC Keyboard Key Layout for Noos Android x86_64
key 1     ESCAPE
key 14    DEL
key 15    TAB
key 28    ENTER
key 29    CTRL_LEFT
key 42    SHIFT_LEFT
key 54    SHIFT_RIGHT
key 56    ALT_LEFT
key 57    SPACE
key 58    CAPS_LOCK
key 97    CTRL_RIGHT
key 100   ALT_RIGHT
key 125   META_LEFT    # Touche Super / Windows -> Ouvre le menu des applications
key 126   META_RIGHT
key 127   MENU
key 103   DPAD_UP
key 108   DPAD_DOWN
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 111   FORWARD_DEL
key 102   HOME
key 107   MOVE_END
key 104   PAGE_UP
key 109   PAGE_DOWN
key 116   POWER
key 114   VOLUME_DOWN
key 115   VOLUME_UP
key 113   VOLUME_MUTE
