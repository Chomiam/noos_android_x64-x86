#!/bin/sh
# ==============================================================================
# Noos Android x86_64 — Early Userspace Boot Orchestrator (initrd)
# Supporting Android 17 (API 37) "Cinnamon Bun" on Linux 6.12 LTS
# Compatible Mini PC (Intel N100 / AMD Ryzen APU / QEMU VirtIO)
# ==============================================================================

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

# 1. Montage des systèmes de fichiers virtuels de base
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Population automatique des périphériques via mdev
if which mdev >/dev/null 2>&1; then
    mdev -s 2>/dev/null || true
fi

mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null || true

# Redirection vers la console graphique active (/dev/tty0 ou console)
if [ -e /dev/tty0 ]; then
    exec < /dev/tty0 > /dev/tty0 2>&1
elif [ -e /dev/console ]; then
    exec < /dev/console > /dev/console 2>&1
fi

echo "========================================================"
echo "      Noos Android 17 (API 37) Early Boot Init          "
echo "        Linux 6.12 LTS - Edition: Cinnamon Bun          "
echo "========================================================"

# 2. Lecture des paramètres de démarrage du noyau
CMDLINE=$(cat /proc/cmdline)

case "$CMDLINE" in
    *EDITION=desktop*|*edition=desktop*)
        EDITION="desktop"
        DEFAULT_DPI=160
        ;;
    *)
        EDITION="tv"
        DEFAULT_DPI=280
        ;;
esac

DPI=$DEFAULT_DPI
for param in $CMDLINE; do
    case "$param" in
        DPI=*|dpi=*)
            DPI="${param#*=}"
            ;;
    esac
done

echo "[Noos Init] Édition active : $EDITION (DPI: $DPI)"

# 3. Recherche du support de stockage contenant Noos Android
echo "[Noos Init] Recherche des partitions Noos Android..."
SRC_DIR="/mnt/noos_boot"
mkdir -p "$SRC_DIR"

FOUND_DEV=""
for try in 1 2 3 4 5; do
    for dev in /dev/sr* /dev/hd* /dev/sd* /dev/nvme* /dev/vd*; do
        [ -e "$dev" ] || continue
        if mount -o ro "$dev" "$SRC_DIR" 2>/dev/null; then
            if [ -f "$SRC_DIR/system.img" ] || [ -f "$SRC_DIR/system.sfs" ] || [ -f "$SRC_DIR/noos/system.sfs" ]; then
                FOUND_DEV="$dev"
                echo "[Noos Init] Système trouvé sur $dev"
                break 2
            fi
            umount "$SRC_DIR" 2>/dev/null
        fi
    done
    sleep 1
done

TARGET_SYS="/android"
mkdir -p "$TARGET_SYS"

if [ -n "$FOUND_DEV" ]; then
    SYS_IMAGE=""
    if [ -f "$SRC_DIR/system.img" ]; then
        SYS_IMAGE="$SRC_DIR/system.img"
    elif [ -f "$SRC_DIR/system_${EDITION}.sfs" ]; then
        SYS_IMAGE="$SRC_DIR/system_${EDITION}.sfs"
    elif [ -f "$SRC_DIR/system.sfs" ]; then
        SYS_IMAGE="$SRC_DIR/system.sfs"
    elif [ -f "$SRC_DIR/noos/system.sfs" ]; then
        SYS_IMAGE="$SRC_DIR/noos/system.sfs"
    fi

    echo "[Noos Init] Montage de system.img : $SYS_IMAGE"
    mkdir -p /mnt/sys_ro /mnt/sys_rw
    if echo "$SYS_IMAGE" | grep -q '\.sfs$'; then
        mount -t squashfs -o loop "$SYS_IMAGE" /mnt/sys_ro
        LOWER_DIR="/mnt/sys_ro"
        if [ -f /mnt/sys_ro/system.img ]; then
            mkdir -p /mnt/img_ro
            mount -t ext4 -o loop,ro /mnt/sys_ro/system.img /mnt/img_ro 2>/dev/null && LOWER_DIR="/mnt/img_ro"
        fi
    else
        mount -t ext4 -o loop,ro "$SYS_IMAGE" /mnt/sys_ro
        LOWER_DIR="/mnt/sys_ro"
    fi

    # Montage OverlayFS en RAM pour le système racine Android
    mount -t tmpfs -o size=2G tmpfs /mnt/sys_rw
    mkdir -p /mnt/sys_rw/upper /mnt/sys_rw/work
    if mount -t overlay overlay -o lowerdir="$LOWER_DIR",upperdir=/mnt/sys_rw/upper,workdir=/mnt/sys_rw/work "$TARGET_SYS" 2>/dev/null; then
        echo "[Noos Init] Système Android monté en OverlayFS RW"
    else
        mount -o bind "$LOWER_DIR" "$TARGET_SYS"
    fi

    # Montage de vendor.img si disponible
    if [ -f "$SRC_DIR/vendor.img" ]; then
        echo "[Noos Init] Montage de la partition Vendor : $SRC_DIR/vendor.img"
        mkdir -p /mnt/vendor_ro
        mount -t ext4 -o loop,ro "$SRC_DIR/vendor.img" /mnt/vendor_ro 2>/dev/null
        mkdir -p "$TARGET_SYS/vendor"
        mount --bind /mnt/vendor_ro "$TARGET_SYS/vendor"
    fi

    # Injection des launchers préinstallés si présents
    if [ -d "$SRC_DIR/apps" ]; then
        echo "[Noos Init] Injection des applications Noos..."
        mkdir -p "$TARGET_SYS/system/priv-app"
        for apk in "$SRC_DIR"/apps/*.apk; do
            [ -f "$apk" ] || continue
            appname=$(basename "$apk" .apk)
            mkdir -p "$TARGET_SYS/system/priv-app/$appname"
            cp "$apk" "$TARGET_SYS/system/priv-app/$appname/$appname.apk" 2>/dev/null || true
            chmod 644 "$TARGET_SYS/system/priv-app/$appname/$appname.apk" 2>/dev/null || true
            echo "  -> App injectée : $appname"
        done
    fi
else
    echo "[Noos Init] ERREUR : aucun média Noos détecté !"
    exec sh
fi

# 4. Création et montage des répertoires d'exécution essentiels Android
mkdir -p "$TARGET_SYS/data" "$TARGET_SYS/metadata" "$TARGET_SYS/apex" "$TARGET_SYS/mnt" "$TARGET_SYS/linkerconfig"
mount -t tmpfs -o size=2G,mode=0771 tmpfs "$TARGET_SYS/data" 2>/dev/null || true
mount -t tmpfs -o size=64M,mode=0700 tmpfs "$TARGET_SYS/metadata" 2>/dev/null || true

# 5. Injection des propriétés système pour Android 17
PROP_FILE="$TARGET_SYS/default.prop"
cat << EOF >> "$PROP_FILE"
# Noos Android 17 Dynamic Configuration
ro.noos.version=17.0.0
ro.noos.edition=$EDITION
ro.sf.lcd_density=$DPI
ro.hardware=ranchu
ro.zygote=zygote64
ro.hardware.gralloc=minigbm
ro.hardware.egl=emulation
ro.hardware.vulkan=ranchu
ro.kernel.qemu=1
ro.boot.qemu=1
ro.dalvik.vm.native.bridge=libndk_translation.so
ro.enable.native.bridge.exec=1
ro.dalvik.vm.isa.arm64=x86_64
EOF

if [ "$EDITION" = "tv" ]; then
    cat << EOF >> "$PROP_FILE"
ro.build.characteristics=tv
ro.noos.ui_mode=leanback
persist.sys.app.rotation=force_land
EOF
else
    cat << EOF >> "$PROP_FILE"
ro.build.characteristics=tablet,desktop
ro.noos.ui_mode=desktop
persist.sys.freeform_window=true
enable_freeform_support=1
EOF
fi

if [ -d "$TARGET_SYS/system/etc" ]; then
    cat "$PROP_FILE" >> "$TARGET_SYS/system/etc/prop.default" 2>/dev/null || true
fi

echo "[Noos Init] Bascule vers Android 17 init..."

# Nettoyage des points de montage avant switch_root
umount /dev/pts 2>/dev/null || true
mount -o move /dev "$TARGET_SYS/dev" 2>/dev/null || true
mount -o move /proc "$TARGET_SYS/proc" 2>/dev/null || true
mount -o move /sys "$TARGET_SYS/sys" 2>/dev/null || true

# Lancement de PID 1 Android
if [ -x "$TARGET_SYS/system/bin/init" ]; then
    exec switch_root "$TARGET_SYS" /system/bin/init second_stage
elif [ -x "$TARGET_SYS/init" ]; then
    exec switch_root "$TARGET_SYS" /init second_stage
else
    echo "[Noos Init] ERREUR : /init ou /system/bin/init introuvable dans $TARGET_SYS !"
    exec sh
fi
